# keybind2me が管理する Vimium キー設定。
# 右の Dock チートシートは、下の sheet 行だけを読む。
# sheet: スクロール
# j/k/h/l | スクロール
# gg / G | 先頭 / 末尾
# Ctrl-d / u | 半ページ
# f / F | リンクを開く
# sheet: タブ
# Space t | 新しいタブ
# Ctrl-o / i | 戻る / 進む
# gt / gT | 次 / 前タブ
# Space q | 閉じる
#
# これより下を Vimium の keyMappings として読み込む。
# unmapAll のあとで割り当て直すので、このファイルに無いキーは無効になる。
# Zen を終了してから vimium/apply.sh を実行するとブラウザへ入る。
# 半ページは Ctrl-d / Ctrl-u、タブは gt / gT、履歴は Ctrl-o / Ctrl-i。Vim の初期キーに合わせてある。
# f はリンクヒント、o は URL を開く。ブラウザには文字検索も行挿入もないので、ここだけ役割が違う。

unmapAll

# ページ内の移動
map j scrollDown
map k scrollUp
map h scrollLeft
map l scrollRight
map gg scrollToTop
map G scrollToBottom
map zH scrollToLeft
map zL scrollToRight
map <c-e> scrollDown
map <c-y> scrollUp
map <c-d> scrollPageDown
map <c-u> scrollPageUp
map <c-f> scrollFullPageDown
map <c-b> scrollFullPageUp
map <space>r reload
map <space>R reload hard
map yy copyCurrentUrl
map p openCopiedUrlInCurrentTab
map P openCopiedUrlInNewTab
map gi focusInput
map [[ goPrevious
map ]] goNext
map gf nextFrame
map gF mainFrame
map gu goUp
map gU goToRoot
map i enterInsertMode
map v enterVisualMode
map V enterVisualLineMode

# リンクヒント
map f LinkHints.activateMode
map F LinkHints.activateModeToOpenInNewTab
map <a-f> LinkHints.activateModeWithQueue
map yf LinkHints.activateModeToCopyLinkUrl

# 検索
map / enterFindMode
map n performFind
map N performBackwardsFind
map * findSelected
map # findSelectedBackwards

# Vomnibar
map o Vomnibar.activate
map O Vomnibar.activateInNewTab
map T Vomnibar.activateTabSelection
map b Vomnibar.activateBookmarks
map B Vomnibar.activateBookmarksInNewTab
map ge Vomnibar.activateEditUrl
map gE Vomnibar.activateEditUrlInNewTab

# 履歴。Vim のジャンプリスト Ctrl-o / Ctrl-i に合わせる。
map <c-o> goBack
map <c-i> goForward

# タブ。Vim の gt / gT。新規と閉じるは Space リーダー。
map gt nextTab
map gT previousTab
map <space>t createTab
map <space>q removeTab
map <space>Q restoreTab
map ^ visitPreviousTab
map g0 firstTab
map g$ lastTab
map <a-p> togglePinTab
map <a-m> toggleMuteTab
map zi zoomIn
map zo zoomOut
map z0 zoomReset

# マーク
map m Marks.activateCreateMode
map ` Marks.activateGotoMode

# その他
map <space>? showHelp
map gs toggleViewSource
